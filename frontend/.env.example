# Belalah HSS Frontend Environment Variables
# In production, replace with your public backend API domain
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Storage base URL for uploaded media (optional, defaults to VITE_API_BASE_URL without /api)
# Example for production: https://api.belalah-hss.com
VITE_STORAGE_BASE_URL=http://127.0.0.1:8000
